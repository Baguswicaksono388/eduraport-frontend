FROM node:22-alpine AS builder

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy root workspace and config files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages ./packages
COPY apps ./apps

# Install all dependencies
RUN pnpm install --frozen-lockfile

# Build platform-admin app
ENV NODE_OPTIONS="--max-old-space-size=2048"
ARG NUXT_PUBLIC_API_BASE=https://api-admin.eduraport.com/api/v1
ENV NUXT_PUBLIC_API_BASE=${NUXT_PUBLIC_API_BASE}

RUN pnpm --filter @eduraport/platform-admin build

# Runner stage
FROM node:22-alpine AS runner

WORKDIR /app

# Copy the self-contained Nuxt build output from builder
COPY --from=builder /app/apps/platform-admin/.output ./.output

# Expose Nuxt port
EXPOSE 3002

ENV PORT=3002
ENV HOST=0.0.0.0
ENV NODE_ENV=production

# Run Nuxt server
CMD ["node", ".output/server/index.mjs"]
